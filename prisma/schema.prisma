generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanTip {
  STARTER_500
  BASIC_1000
  STANDARD_5000
  ADVANCED_10000
  PRO_25000
  ELITE_50000
}

enum StatusEvaluare {
  INACTIV
  FAZA_1
  FAZA_2
  FINANTAT
  RESPINS
  SUSPENDAT
}

enum StatusKYC {
  NEVERIFICAT
  IN_ASTEPTARE
  APROBAT
  RESPINS
}

enum TipPariu {
  SIMPLU
  COMBINAT
  SISTEM
  LIVE
}

enum StatusPariu {
  DESCHIS
  CASTIGAT
  PIERDUT
  ANULAT
  JUMATATE_CASTIG
}

model Utilizator {
  id                String       @id @default(cuid())
  supabaseId        String       @unique
  email             String       @unique
  numeComplet       String?
  telefon           String?
  tara              String?
  dataInregistrare  DateTime     @default(now())
  statusKYC         StatusKYC    @default(NEVERIFICAT)
  sumsubApplicantId String?
  stripeCustomerId  String?
  conturi           ContTrader[]
  pariuri           Pariu[]
  retrageri         Retragere[]
  afiliat           Afiliat?
}

model ContTrader {
  id              String         @id @default(cuid())
  utilizatorId    String
  utilizator      Utilizator     @relation(fields: [utilizatorId], references: [id])
  plan            PlanTip
  capitalInceput  Float
  capitalCurent   Float
  statusEvaluare  StatusEvaluare @default(INACTIV)
  fazaCurenta     Int            @default(1)
  profitTotal     Float          @default(0)
  pierdereMaxima  Float          @default(0)
  tranzactiiTotal Int            @default(0)
  dataStart       DateTime?
  dataFinalizare  DateTime?
  stripeSessionId String?        @unique
  activ           Boolean        @default(true)
  createdAt       DateTime       @default(now())
  pariuri         Pariu[]
  reguli          RegulaCont[]
}

model Pariu {
  id                String      @id @default(cuid())
  utilizatorId      String
  utilizator        Utilizator  @relation(fields: [utilizatorId], references: [id])
  contId            String
  cont              ContTrader  @relation(fields: [contId], references: [id])
  sport             String
  eveniment         String
  piata             String
  selectie          String
  cota              Float
  suma              Float
  potentialCastig   Float
  tipPariu          TipPariu    @default(SIMPLU)
  statusPariu       StatusPariu @default(DESCHIS)
  castigSauPierdere Float?
  dataPariu         DateTime    @default(now())
  dataRezultat      DateTime?
  note              String?
}

enum WithdrawalState {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
  REFUNDED
}

model Retragere {
  id              String          @id @default(cuid())
  utilizatorId    String
  utilizator      Utilizator      @relation(fields: [utilizatorId], references: [id])
  suma            Float
  metodaPlata     String
  detaliiPlata    Json
  /// Legacy free-form status — kept for backwards compatibility with admin UI.
  status          String          @default("IN_PROCESARE")
  /// Strongly-typed state machine for withdrawals.
  state           WithdrawalState @default(PENDING)
  /// Client-supplied idempotency key — uniqueness prevents double-spend on retries.
  idempotencyKey  String?         @unique
  /// Optional ledger entry produced when the withdrawal debit hit the books.
  ledgerEntryId   String?         @unique
  failureReason   String?
  approvedAt      DateTime?
  processedAt     DateTime?
  createdAt       DateTime        @default(now())
  procesatLa      DateTime?
  ledgerEntries   Ledger[]        @relation("RetragereLedger")
}

/// Append-only ledger for monetary movements. SQL-level RULEs in the
/// accompanying migration block UPDATE/DELETE so history can never be edited.
model Ledger {
  id             String      @id @default(cuid())
  utilizatorId   String
  /// Account that produced the movement (null for system entries like fees).
  contId         String?
  /// Withdrawal that created this entry (debit when approved, credit on refund).
  retragereId    String?
  retragere      Retragere?  @relation("RetragereLedger", fields: [retragereId], references: [id])
  /// One of: WITHDRAWAL_DEBIT, WITHDRAWAL_REFUND, BET_STAKE, BET_PAYOUT, ADJUSTMENT, FEE, DEPOSIT.
  kind           String
  /// Signed amount in the user's home currency (negative = debit, positive = credit).
  amount         Float
  currency       String      @default("EUR")
  /// Free-form correlation ID — stripe event id, sumsub digest, etc.
  externalRef    String?
  /// Idempotency key reused from the source action to deduplicate writes.
  idempotencyKey String?     @unique
  metadata       Json?
  createdAt      DateTime    @default(now())

  @@index([utilizatorId, createdAt])
  @@index([contId, createdAt])
  @@index([retragereId])
}

/// Records every webhook delivery we have already executed handlers for so a
/// second attempt by Stripe / Sumsub becomes a no-op.
model ProcessedWebhookEvent {
  /// `${provider}:${eventId}` — e.g. `stripe:evt_123` or `sumsub:<digest>`.
  id          String   @id
  provider    String
  eventId     String
  eventType   String?
  payloadHash String?
  processedAt DateTime @default(now())

  @@index([provider, processedAt])
}

model RegulaCont {
  id           String     @id @default(cuid())
  contId       String
  cont         ContTrader @relation(fields: [contId], references: [id])
  numeFaza     String
  targetProfit Float
  maxPierdere  Float
  maxZilnic    Float
  zileMinime   Int
  completata   Boolean    @default(false)
}

model Afiliat {
  id           String            @id @default(cuid())
  utilizatorId String            @unique
  utilizator   Utilizator        @relation(fields: [utilizatorId], references: [id])
  codReferral  String            @unique
  comisioane   ComisionAfiliat[]
  createdAt    DateTime          @default(now())
}

model ComisionAfiliat {
  id          String   @id @default(cuid())
  afiliatId   String
  afiliat     Afiliat  @relation(fields: [afiliatId], references: [id])
  suma        Float
  procent     Float
  referralId  String
  status      String   @default("IN_PROCESARE")
  createdAt   DateTime @default(now())
}

/// GDPR consent log. We persist (userId|sessionId, version, ip, userAgent) so
/// consent is demonstrable per ANSPDCP guidance. The cookie banner POSTs to
/// /api/consent which writes one row per change-of-mind. The newest row for
/// a given (userId|sessionId, version) pair is the authoritative one.
model Consent {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String
  necessary Boolean  @default(true)
  analytics Boolean  @default(false)
  marketing Boolean  @default(false)
  version   Int      @default(1)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, version])
  @@index([sessionId, version])
}
