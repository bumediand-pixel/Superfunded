generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanTip {
  STARTER_500
  BASIC_1000
  STANDARD_5000
  ADVANCED_10000
  PRO_25000
  ELITE_50000
}

enum StatusEvaluare {
  INACTIV
  FAZA_1
  FAZA_2
  FINANTAT
  RESPINS
  SUSPENDAT
}

enum StatusKYC {
  NEVERIFICAT
  IN_ASTEPTARE
  APROBAT
  RESPINS
}

enum TipPariu {
  SIMPLU
  COMBINAT
  SISTEM
  LIVE
}

enum StatusPariu {
  DESCHIS
  CASTIGAT
  PIERDUT
  ANULAT
  JUMATATE_CASTIG
}

enum StatusRetragere {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
  REFUNDED
}

enum LedgerEntryType {
  WITHDRAWAL_HOLD
  WITHDRAWAL_PAID
  WITHDRAWAL_REFUND
  BET_STAKE
  BET_PAYOUT
  CHALLENGE_PURCHASE
  CHALLENGE_REFUND
  ADJUSTMENT
}

model Utilizator {
  id                String       @id @default(cuid())
  supabaseId        String       @unique
  email             String       @unique
  numeComplet       String?
  telefon           String?
  tara              String?
  dataInregistrare  DateTime     @default(now())
  statusKYC         StatusKYC    @default(NEVERIFICAT)
  sumsubApplicantId String?
  stripeCustomerId  String?
  conturi           ContTrader[]
  pariuri           Pariu[]
  retrageri         Retragere[]
  ledger            Ledger[]
  afiliat           Afiliat?
}

model ContTrader {
  id              String         @id @default(cuid())
  utilizatorId    String
  utilizator      Utilizator     @relation(fields: [utilizatorId], references: [id])
  plan            PlanTip
  capitalInceput  Float
  capitalCurent   Float
  statusEvaluare  StatusEvaluare @default(INACTIV)
  fazaCurenta     Int            @default(1)
  profitTotal     Float          @default(0)
  pierdereMaxima  Float          @default(0)
  tranzactiiTotal Int            @default(0)
  dataStart       DateTime?
  dataFinalizare  DateTime?
  stripeSessionId String?        @unique
  activ           Boolean        @default(true)
  createdAt       DateTime       @default(now())
  pariuri         Pariu[]
  reguli          RegulaCont[]
}

model Pariu {
  id                String      @id @default(cuid())
  utilizatorId      String
  utilizator        Utilizator  @relation(fields: [utilizatorId], references: [id])
  contId            String
  cont              ContTrader  @relation(fields: [contId], references: [id])
  sport             String
  eveniment         String
  piata             String
  selectie          String
  cota              Float
  suma              Float
  potentialCastig   Float
  tipPariu          TipPariu    @default(SIMPLU)
  statusPariu       StatusPariu @default(DESCHIS)
  castigSauPierdere Float?
  dataPariu         DateTime    @default(now())
  dataRezultat      DateTime?
  note              String?
}

model Retragere {
  id              String          @id @default(cuid())
  utilizatorId    String
  utilizator      Utilizator      @relation(fields: [utilizatorId], references: [id])
  suma            Float
  metodaPlata     String
  detaliiPlata    Json
  status          String          @default("IN_PROCESARE")
  // P0: explicit state-machine status (parallel to legacy `status` string for back-compat)
  statusEnum      StatusRetragere @default(PENDING)
  // Idempotency key supplied by client (UUID v4) — prevents double-submits + retry storms
  idempotencyKey  String?         @unique
  failureReason   String?
  ledgerEntries   Ledger[]
  createdAt       DateTime        @default(now())
  procesatLa      DateTime?
  updatedAt       DateTime        @updatedAt
}

/// Append-only money ledger. Database RULES (see migrations/20260509_p0_security/migration.sql)
/// block UPDATE/DELETE so this table is the auditable source of truth for every cent.
model Ledger {
  id            String          @id @default(cuid())
  utilizatorId  String
  utilizator    Utilizator      @relation(fields: [utilizatorId], references: [id])
  contId        String?
  type          LedgerEntryType
  /// Signed amount in EUR. Positive = credit to user, negative = debit.
  amount        Float
  currency      String          @default("EUR")
  /// Free-form reference to the originating domain object (retragereId, pariuId, sessionId).
  refType       String?
  refId         String?
  retragereId   String?
  retragere     Retragere?      @relation(fields: [retragereId], references: [id])
  metadata      Json?
  createdAt     DateTime        @default(now())

  @@index([utilizatorId, createdAt])
  @@index([refType, refId])
}

/// Webhook idempotency table — every Stripe / Sumsub event is recorded here BEFORE
/// any side-effect runs. Unique on (provider, eventId) prevents duplicate processing.
model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
}

model RegulaCont {
  id           String     @id @default(cuid())
  contId       String
  cont         ContTrader @relation(fields: [contId], references: [id])
  numeFaza     String
  targetProfit Float
  maxPierdere  Float
  maxZilnic    Float
  zileMinime   Int
  completata   Boolean    @default(false)
}

model Afiliat {
  id           String            @id @default(cuid())
  utilizatorId String            @unique
  utilizator   Utilizator        @relation(fields: [utilizatorId], references: [id])
  codReferral  String            @unique
  comisioane   ComisionAfiliat[]
  createdAt    DateTime          @default(now())
}

model ComisionAfiliat {
  id          String   @id @default(cuid())
  afiliatId   String
  afiliat     Afiliat  @relation(fields: [afiliatId], references: [id])
  suma        Float
  procent     Float
  referralId  String
  status      String   @default("IN_PROCESARE")
  createdAt   DateTime @default(now())
}
