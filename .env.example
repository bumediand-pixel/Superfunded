# ─── Public — exposed to client ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://thesuperfunded.com"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/superfunded"

# ─── Demo mode (pre-launch) ─────────────────────────────────────────────────
# When 'true', leaderboard + public stats return hardcoded marketing-friendly
# numbers instead of querying the (empty) DB. Flip off after first 50 users.
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# ─── Database — Postgres (Supabase or self-hosted) ─────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/superfunded?schema=public"
DIRECT_URL="postgresql://user:pass@host:5432/superfunded?schema=public"

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Sumsub KYC ─────────────────────────────────────────────────────────────
SUMSUB_APP_TOKEN=""
SUMSUB_SECRET_KEY=""
SUMSUB_LEVEL_NAME="basic-kyc-level"
# Webhook signing secret (separate from SECRET_KEY) — configured in Sumsub admin UI.
SUMSUB_WEBHOOK_SECRET=""

# ─── Resend (transactional email) ──────────────────────────────────────────
RESEND_API_KEY=""
ADMIN_EMAIL="admin@superfunded.ro"
CONTACT_INBOX_EMAIL="support@superfunded.ro"

# ─── The Odds API (live odds + scores feed) ────────────────────────────────
# Sign up: https://the-odds-api.com/
ODDS_API_KEY=""

# ─── Cron — protects /api/cron/* endpoints ─────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ─── Upstash Redis (production rate limiting) ──────────────────────────────
# Required on Vercel — in-memory limiter doesn't survive serverless invocations.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Plausible Analytics (optional, privacy-first) ─────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""        # e.g. "superfunded.ro"
NEXT_PUBLIC_PLAUSIBLE_HOST=""          # default https://plausible.io; override for self-hosted
