DIRECT_URL="postgresql://user:pass@host:5432/superfunded?schema=public"

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Sumsub KYC ─────────────────────────────────────────────────────────────
SUMSUB_APP_TOKEN=""
SUMSUB_SECRET_KEY=""
